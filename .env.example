# ==============================================================================
# SMART PANTRY ASSISTANT MVP — VARIÁVEIS DE AMBIENTE (RNF05)
# Copie este arquivo para ".env" na raiz do projeto (e/ou em backend/.env).
# NUNCA faça commit do arquivo .env com credenciais reais no Git!
# ==============================================================================

# --- Servidor Backend ---
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
TZ=America/Sao_Paulo

# --- Google Gemini API (Google AI Studio / Créditos Google AI Pro) ---
# Gere sua chave em: https://aistudio.google.com/apikey
# Se você assina Google AI Pro, resgate os créditos mensais de desenvolvedor no menu lateral do AI Studio.
GEMINI_API_KEY=coloque_sua_chave_gemini_aqui
# Modelo multimodal padrão via Interactions API (@google/genai >= 3.5.0)
# gemini-3.5-flash-lite: ultra-rápido (~2-3s com thinking_level minimal) e menor custo
# Alternativas: gemini-3.1-flash-lite | gemini-4-hydrogen (raciocínio mais profundo)
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Supabase PostgreSQL (RF04 & RNF06) ---
# Se deixado em branco, o backend ativa automaticamente o modo de persistência local em JSON (backend/data/pantry.json)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Usuário Padrão do Painel Web / Simulador ---
DEFAULT_USER_CHAT_ID=usr_telegram_99412
DEFAULT_USER_NAME=Usuário MVP
ALERT_WINDOW_DAYS=5

# --- Cron Job Diário (RF06) ---
# Padrão: todos os dias à meia-noite (0 0 * * *)
CRON_SCHEDULE=0 0 * * *
CRON_ENABLED=true

# --- Bot Telegram (RF01 & RF08 - Opcional para disparo real) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# --- WhatsApp Cloud API (RF01 & RF08 - Opcional para disparo real) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=smart_pantry_verify_2026

# --- n8n / Docker (RNF03) ---
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=troque_esta_senha_segura

# --- Frontend (Vite) ---
VITE_API_URL=http://localhost:3001
